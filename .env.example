# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ==============================================================================
# SECURE SERVER-SIDE EMAIL CONFIGURATION
# Enquiry details are delivered to: naviora.pvt@gmail.com
# Sent from: navioraa.technology@gmail.com
# ==============================================================================

# Destination inbox (where inquiries are delivered)
NOTIFICATION_RECIPIENT="naviora.pvt@gmail.com"

# Sender address
EMAIL_SENDER="navioraa.technology@gmail.com"

# OPTION A (Direct Gmail SMTP from navioraa.technology@gmail.com):
# Generate a 16-character Google App Password in:
# Google Account (navioraa.technology@gmail.com) -> Security -> 2-Step Verification -> App Passwords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="navioraa.technology@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"

# OPTION B (Resend API):
# Obtain an API key from https://resend.com
# Delivered directly to naviora.pvt@gmail.com with sender display name navioraa.technology@gmail.com
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxx"
